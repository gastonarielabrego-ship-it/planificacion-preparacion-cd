// Esquema Prisma - SQLite (desarrollo sandbox)
// Para produccion (Vercel + Neon) se usa prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ola y pendiente diaria (bultos a preparar por dia)
model OlaDia {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @unique
  ola       Float
  pendiente Float
  total     Float
}

// H61 pre-agregado: un registro por operario x dia
model H61OpDia {
  id           Int      @id @default(autoincrement())
  fecha        DateTime
  operario     String
  nombre       String?
  funcion      String
  turno        String
  horasActivas Int
  bultos       Int
  bultosBase   Int
  bultosExtras Int
  extras       Int
  @@unique([fecha, operario])
  @@index([fecha])
}

// H61 pre-agregado: produccion por turno x hora x dia
model H61TurnoHora {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  turno     String
  hora      Int
  bultos    Int
  operarios Int
  @@unique([fecha, turno, hora])
  @@index([fecha])
}

// H61: bultos por operario x hora (permite distinguir jornada vs horas extra)
model H61OpHora {
  id       Int     @id @default(autoincrement())
  fecha    DateTime
  operario String
  turno    String
  hora     Int
  bultos   Int
  esExtra  Boolean
  @@unique([fecha, operario, hora])
  @@index([fecha])
}

// H61 pre-agregado: produccion por circuito x funcion x dia
model H61Circuito {
  id       Int      @id @default(autoincrement())
  fecha    DateTime
  circuito String
  funcion  String
  bultos   Int
  @@unique([fecha, circuito, funcion])
  @@index([fecha])
}

// H61 pre-agregado: produccion por actividad (columna ACTIVIDAD del archivo: 2, 3, 4, JAULA...)
model H61Actividad {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  actividad String
  bultos    Int
  operarios Int
  horas     Int
  @@unique([fecha, actividad])
  @@index([fecha])
}

// Tiempos muertos normalizados
model TiempoMuerto {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  turno       String
  operario    String
  nombre      String?
  motivoCode  Int?
  categoria   String
  detalle     String?
  nave        String?
  pasillo     String?
  posicion    String?
  minutos     Int
  minutosAj   Int
  minutosEf   Int
  horaDesde   Int?
  estado      String?
  obs         String?
  @@index([fecha])
  @@index([categoria])
}

// Eventos de picking (archivo grande subido por script Python)
model PickingEvento {
  id        Int      @id @default(autoincrement())
  batch     String
  fecha     DateTime
  operario  String
  nombre    String?
  horaMin   Float?
  bultos    Int?
  soporte   String?
  circuito  String?
  actividad String? // CODACT: actividad/circuito del WMS
  zona      String? // ZONSTS: zona = nave
  ubicacion String? // ALLSTS: pasillo/ubicacion
  nivel     String? // NIVSTS: nivel
  minutos   Float? // MINUTOS: duracion de la operacion
  raw       String?
  @@index([fecha, operario])
  @@index([batch])
}


// Productividad por colaborador y sector (archivos "Productividad X Circuito" / "Tiempos E-8")
model ProdCircuito {
  id              Int      @id @default(autoincrement())
  fecha           DateTime
  turno           String   @default("")
  operario        String
  nombre          String?
  sector          String   @default("")
  tipo            String   @default("")
  soportes        Float?
  lineas          Float?
  bultos          Float?
  tiempoTotal     Float?
  tiempoMuerto    Float?
  tiempoNeto      Float?
  tiempoSuperNeto Float?
  prodTotal       Float?
  prodNeto        Float?
  prodSuperNeto   Float?
  @@unique([fecha, turno, operario, sector, tipo])
  @@index([fecha])
  @@index([sector])
}

// Feriados nacionales de Argentina (fuente: api.argentinadatos.com.ar)
model Feriado {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @unique
  nombre String
  tipo   String
}

// Trazabilidad de cargas
model UploadBatch {
  id        String   @id
  tipo      String
  filename  String?
  rows      Int
  meta      String?
  createdAt DateTime @default(now())
}

// Partes de una subida por chunks (archivos grandes desde la web; Vercel limita cada request a ~4,5 MB)
model UploadChunk {
  id        String   @id @default(cuid())
  fileId    String
  idx       Int
  data      String
  createdAt DateTime @default(now())
  @@unique([fileId, idx])
}
