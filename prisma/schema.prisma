// Esquema Prisma - SQLite (desarrollo sandbox)
// Para produccion (Vercel + Neon) se usa prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ola y pendiente diaria (bultos a preparar por dia)
model OlaDia {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @unique
  ola       Float
  pendiente Float
  total     Float
}

// H61 pre-agregado: un registro por operario x dia
model H61OpDia {
  id           Int      @id @default(autoincrement())
  fecha        DateTime
  operario     String
  nombre       String?
  funcion      String
  turno        String
  horasActivas Int
  bultos       Int
  bultosBase   Int
  bultosExtras Int
  extras       Int
  @@unique([fecha, operario])
  @@index([fecha])
}

// H61 pre-agregado: produccion por turno x hora x dia
model H61TurnoHora {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  turno     String
  hora      Int
  bultos    Int
  operarios Int
  @@unique([fecha, turno, hora])
  @@index([fecha])
}

// H61: bultos por operario x hora (permite distinguir jornada vs horas extra)
model H61OpHora {
  id       Int     @id @default(autoincrement())
  fecha    DateTime
  operario String
  turno    String
  hora     Int
  bultos   Int
  esExtra  Boolean
  @@unique([fecha, operario, hora])
  @@index([fecha])
}

// H61 pre-agregado: produccion por circuito x funcion x dia
model H61Circuito {
  id       Int      @id @default(autoincrement())
  fecha    DateTime
  circuito String
  funcion  String
  bultos   Int
  @@unique([fecha, circuito, funcion])
  @@index([fecha])
}

// H61 pre-agregado: produccion por actividad (columna ACTIVIDAD del archivo: 2, 3, 4, JAULA...)
model H61Actividad {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  actividad String
  bultos    Int
  operarios Int
  horas     Int
  @@unique([fecha, actividad])
  @@index([fecha])
}

// H61 de maquinistas (clarkistas): fila por operario x fecha x turno x actividad x nave.
// nave = CIRCUITO del archivo (AP2, PA2, BE2, XXX = varios...). total = movimientos de clark,
// bultos = TOT_BULTOS, horas = horas activas distintas dentro de la combinacion.
model MaqOpNave {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  turno     String
  operario  String
  nombre    String?
  actividad String
  nave      String
  total     Int
  bultos    Int
  horas     Int
  // apros = TOT_APROS + TOT_APROS_PARCIAL (movimientos de aprontamiento)
  // homogeneos = TOT_HOMOGENEOS (STD + REALMAC_XD + REALMAC_STD)
  apros      Int @default(0)
  homogeneos Int @default(0)
  // movimientos por hora del dia (HORA_00..23 del reporte); se suman al fusionar
  // filas de la misma clave. Σ horaHH == total (verificación de consistencia)
  hora00 Int @default(0)
  hora01 Int @default(0)
  hora02 Int @default(0)
  hora03 Int @default(0)
  hora04 Int @default(0)
  hora05 Int @default(0)
  hora06 Int @default(0)
  hora07 Int @default(0)
  hora08 Int @default(0)
  hora09 Int @default(0)
  hora10 Int @default(0)
  hora11 Int @default(0)
  hora12 Int @default(0)
  hora13 Int @default(0)
  hora14 Int @default(0)
  hora15 Int @default(0)
  hora16 Int @default(0)
  hora17 Int @default(0)
  hora18 Int @default(0)
  hora19 Int @default(0)
  hora20 Int @default(0)
  hora21 Int @default(0)
  hora22 Int @default(0)
  hora23 Int @default(0)
  @@unique([fecha, turno, operario, actividad, nave])
  @@index([fecha])
}

// Maquinistas pre-agregado por fecha x actividad: operarios distintos y horas-hombre
// con horas unicas por operario (no duplica si comparte la hora entre naves)
model MaqAct {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  actividad String
  bultos    Int
  operarios Int
  horas     Int
  @@unique([fecha, actividad])
  @@index([fecha])
}

// Maquinistas pre-agregado por fecha x nave: operarios distintos y horas-hombre unicas
model MaqNave {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  nave      String
  bultos    Int
  operarios Int
  horas     Int
  @@unique([fecha, nave])
  @@index([fecha])
}

// Tiempos muertos normalizados
model TiempoMuerto {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  turno       String
  operario    String
  nombre      String?
  motivoCode  Int?
  categoria   String
  detalle     String?
  nave        String?
  pasillo     String?
  posicion    String?
  minutos     Int
  minutosAj   Int
  minutosEf   Int
  horaDesde   Int?
  estado      String?
  obs         String?
  @@index([fecha])
  @@index([categoria])
}

// Eventos de picking (archivo grande subido por script Python)
model PickingEvento {
  id        Int      @id @default(autoincrement())
  batch     String
  fecha     DateTime
  operario  String
  nombre    String?
  horaMin   Float?
  bultos    Int?
  soporte   String?
  circuito  String?
  actividad String? // CODACT: actividad/circuito del WMS
  zona      String? // ZONSTS: zona = nave
  ubicacion String? // ALLSTS: pasillo/ubicacion
  nivel     String? // NIVSTS: nivel
  minutos   Float? // MINUTOS: duracion de la operacion
  raw       String?
  @@index([fecha, operario])
  @@index([batch])
}


// Feriados nacionales de Argentina (fuente: api.argentinadatos.com.ar)
model Feriado {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @unique
  nombre String
  tipo   String
}

// Trazabilidad de cargas
model UploadBatch {
  id        String   @id
  tipo      String
  filename  String?
  rows      Int
  meta      String?
  createdAt DateTime @default(now())
}

// Partes de una subida por chunks (archivos grandes desde la web; Vercel limita cada request a ~4,5 MB)
model UploadChunk {
  id        String   @id @default(cuid())
  fileId    String
  idx       Int
  data      Bytes // binario puro: base64 en texto ocupaba ~33% mas y llenaba la base de 512 MB
  createdAt DateTime @default(now())
  @@unique([fileId, idx])
}

// Filas ya mapeadas de un archivo por partes, esperando inserción final por tandas
// (pipeline por pasos para que ninguna llamada al servidor supere el timeout de Vercel)
model UploadStage {
  id        Int      @id @default(autoincrement())
  fileId    String
  data      String // JSON: array de filas compactas
  createdAt DateTime @default(now())
  @@index([fileId])
}
